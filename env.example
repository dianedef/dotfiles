# Dotfiles Environment Configuration
# Copy this to .env and customize for your setup
# install.sh will source this automatically on Codespace boot

# === Logging Configuration ===
LOG_LEVEL=INFO          # DEBUG, INFO, WARN, ERROR
DEBUG_MODE=false        # Set to true for verbose debugging

# === GitHub CLI Authentication ===
# Option 1: GitHub Token (preferred for automated auth)
# Get from: https://github.com/settings/tokens (needs 'repo' scope)
# GH_TOKEN=ghp_your_github_token_here
# GITHUB_TOKEN=ghp_your_github_token_here

# Option 2: Leave empty for manual 'gh auth login' (interactive)
# If empty and not in Doppler, install.sh will skip auth

# === OpenAI / AI Services ===
# OPENAI_API_KEY=sk-your_openai_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# === Copilot / Kilocode ===
# (Usually authenticated via 'gh auth' or 'kilocode login')
# Add custom tokens here if needed
# COPILOT_TOKEN=your_copilot_token_here

# === Doppler Integration ===
# If using Doppler, set this to skip manual prompts
# DOPPLER_TOKEN=dp.st.your_doppler_token_here
# DOPPLER_PROJECT=your_project_name
# DOPPLER_CONFIG=dev  # or prd, stg, etc.

# === Custom Installation Flags ===
# Skip specific installations (set to "true" to skip)
SKIP_NEOVIM_INSTALL=false
SKIP_NERD_FONTS=false
SKIP_YAZI_INSTALL=false
SKIP_DOPPLER_INSTALL=false
SKIP_NPM_TOOLS=false

# Auto-install Neovim plugins on boot (increases startup time ~2-3 min)
# Set to "true" to enable, "false" to defer until first nvim launch
AUTO_INSTALL_NVIM_PLUGINS=false

# === Neovim Configuration ===
# Default Neovim config to use (nvim11, nvim22, or custom path)
DEFAULT_NVIM_CONFIG=nvim11

# === Shell Integration ===
# Automatically add integrations to ~/.bashrc
AUTO_SETUP_BASHRC=true
AUTO_SETUP_STARSHIP=true
AUTO_SETUP_ZOXIDE=true
AUTO_SETUP_ALIASES=true

# === Termux-specific Settings ===
# (Only relevant when running termux.sh)
TERMUX_SKIP_COPILOT=true
TERMUX_LIGHTWEIGHT_MODE=true
