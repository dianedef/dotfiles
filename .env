# Dotfiles Environment Configuration
# Auto-loaded by install.sh on Codespace boot
# Safe defaults for non-interactive installation

# === Logging Configuration ===
LOG_LEVEL=INFO
DEBUG_MODE=false

# === GitHub CLI Authentication ===
# Leave empty - will fall back to Doppler or skip auth
# User can manually run 'gh auth login' or setup Doppler later
# Note: Git identity is auto-configured by GitHub when you authenticate with 'gh auth'
GH_TOKEN=
GITHUB_TOKEN=

# === Doppler Integration ===
# Service Token for non-interactive authentication (get from: https://dashboard.doppler.com)
# Format: dp.st.{env}.{token} (e.g., dp.st.dev.abc123)
# If set, Doppler CLI will authenticate automatically without browser login
DOPPLER_TOKEN=dp.st.dev.w4BSuw9EYLY9tTWM15SDs6tQ51DQCebkjQ2ZQxHNP9R

# === OpenAI / AI Services ===
# Leave empty - user should setup via Doppler or manual config
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Custom Installation Flags ===
SKIP_NEOVIM_INSTALL=false
SKIP_NERD_FONTS=false
SKIP_YAZI_INSTALL=false
SKIP_DOPPLER_INSTALL=false
SKIP_NPM_TOOLS=false

# Defer plugin installation to first launch (faster boot)
AUTO_INSTALL_NVIM_PLUGINS=false

# === Neovim Configuration ===
DEFAULT_NVIM_CONFIG=nvim11

# === Shell Integration ===
AUTO_SETUP_BASHRC=true
AUTO_SETUP_STARSHIP=true
AUTO_SETUP_ZOXIDE=true
AUTO_SETUP_ALIASES=true

# === Termux-specific Settings ===
TERMUX_SKIP_COPILOT=true
TERMUX_LIGHTWEIGHT_MODE=true
