{
  "production_branch": "master",
  "lanes": [
    {
      "id": "dotfiles-contracts",
      "runtime": "shell",
      "root": ".",
      "paths": ["**"],
      "commands": [
        "rg --version",
        "bash -n install-dotfiles.sh dotfiles/install.sh dotfiles/bootstrap.sh dotfiles/install-dotfiles.sh dotfiles/config.sh dotfiles/lib.sh",
        "bash tests/fresh-install-contract.sh",
        "bash tests/runtime-layout-contract.sh",
        "bash tests/symlink-safety.sh",
        "bash tests/linux-user-local-regressions.sh",
        "bash tests/linux-installer-behavior.sh",
        "bash tests/linux-bootstrap-contract.sh",
        "bash tests/windows-bootstrap-contract.sh",
        "bash tests/codex-acp-installation.sh"
      ]
    }
  ]
}
