{
  "mcpServers": {
    "consensus": {
      "type": "http",
      "url": "https://mcp.consensus.app/mcp"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "clerk": {
      "type": "http",
      "url": "https://mcp.clerk.com/mcp"
    },
    "unicon": {
      "type": "http",
      "url": "https://unicon.webrenew.com/api/mcp"
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/${FIRECRAWL_MCP_ID}/v2/mcp"
    },
    "dfs-mcp": {
      "type": "http",
      "url": "https://mcp.dataforseo.com/http",
      "headers": {
        "Authorization": "Basic ${DFS_AUTH_TOKEN}"
      }
    },
    "composio": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "composio-mcp@latest", "start"],
      "env": {}
    },
    "deepl": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "deepl-mcp-server"],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    },
    "gsc": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@anthropic-community/mcp-gsc"],
      "env": {}
    },
    "mcp-server-chart": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@antv/mcp-server-chart"],
      "env": {}
    },
    "mcp-kroki": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@tkoba1974/mcp-kroki"],
      "env": {}
    }
  }
}
