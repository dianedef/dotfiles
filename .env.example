# Dotfiles Configuration
# ============================================================================
# Copy to .env and customize:  cp .env.example .env
#
# All values are optional — defaults are used when not set.
# API keys are prompted interactively during installation.
# ============================================================================

# === User Identity ===
# Auto-detected from GitHub CLI if authenticated
# USER_NAME=Diane
# USER_EMAIL=35034946+dianedef@users.noreply.github.com
# GITHUB_USERNAME=dianedef

# === Installation Options ===
# SKIP_NEOVIM_INSTALL=true
# SKIP_NERD_FONTS=true
# SKIP_YAZI_INSTALL=true
# SKIP_DOPPLER_INSTALL=true
# SKIP_NPM_TOOLS=true
# SKIP_MCP_INSTALL=true
# SKIP_SHIPFLOW=true

# === MCP Server API Keys ===
# Prompted interactively during install — set here to skip prompts
# FIRECRAWL_API_KEY=fc-...           # https://firecrawl.dev
# FIRECRAWL_MCP_ID=fc-...            # Firecrawl MCP instance ID (from URL)
# DEEPL_API_KEY=...                  # https://deepl.com/pro-api
# DFS_AUTH_TOKEN=...                 # https://dataforseo.com (Base64 user:pass)

# === ShipFlow (Web Publishing) ===
# DUCKDNS_TOKEN=...                  # https://duckdns.org
# DUCKDNS_SUBDOMAIN=...              # Your chosen subdomain

# === Advanced ===
# DOTFILES_BIN_DIR=$HOME/.local/bin
# DOTFILES_NPM_DIR=$HOME/.npm-global
# DOTFILES_LOG_LEVEL=INFO            # DEBUG, INFO, WARN, ERROR
# DOTFILES_CACHE_TTL=300             # GitHub API cache in seconds
# DOTFILES_PARALLEL=true             # Parallel installation (faster)
