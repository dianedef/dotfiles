# Claude Code runtime files - generated automatically during usage
# Only config files are versioned (settings.json, statusline scripts)

# Debug logs and stats
debug/
statsig/
stats-cache.json

# Shell snapshots (temporary)
shell-snapshots/

# Session environment data (temporary)
session-env/

# File history (internal version control, too large)
file-history/

# Plugins - only exclude downloaded marketplaces content
plugins/marketplaces/

# Session data (large, not needed in dotfiles)
.claude/
projects/
history.jsonl
cache/
paste-cache/
plans/
tasks/
todos/

# Credentials (sensitive)
.credentials.json
